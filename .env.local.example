# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_INVOICING_URL=http://localhost:3000
# Product evaluation flags
# Treasury is hidden by default; enable it only in development or review environments.
NEXT_PUBLIC_TREASURY_ENABLED=false
ADMIN_EMAILS=founder@example.com
CRON_SECRET=change-this-cron-secret
WORKER_SECRET=change-this-worker-secret

# Authentication abuse protection
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# OAuth token encryption (use at least 32 random characters)
EMAIL_TOKEN_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# Transactional email
RESEND_API_KEY=re_your-key
RESEND_FROM_EMAIL=Mohasib <noreply@mohasibai.com>
FOUNDER_NOTIFICATION_EMAIL=founder@example.com

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PDF microservice
PDF_SERVICE_URL=http://localhost:5050
PDF_SECRET=change-this-secret

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=your-project-id
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=your_read_token
SANITY_REVALIDATE_SECRET=change-this-webhook-secret

# Sentry error monitoring (keep SENTRY_AUTH_TOKEN secret)
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_ORG=your-sentry-organization-slug
SENTRY_PROJECT=your-sentry-project-slug
SENTRY_AUTH_TOKEN=sntrys_your-source-map-token
SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
